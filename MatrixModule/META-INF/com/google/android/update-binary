#!/sbin/sh
##########################################################################################
# MatrixModule Update Binary (KernelSU / APatch / Magisk Compatible)
##########################################################################################

umask 022

OUTFD=$2
ZIPFILE=$3

ui_print() { echo "$1"; }

# Detect environment
if [ -f /data/adb/ksu/util_functions.sh ]; then
    . /data/adb/ksu/util_functions.sh
elif [ -f /data/adb/ap/util_functions.sh ]; then
    . /data/adb/ap/util_functions.sh
elif [ -f /data/adb/magisk/util_functions.sh ]; then
    . /data/adb/magisk/util_functions.sh
else
    ui_print "! Unsupported root environment or missing util_functions.sh"
    exit 1
fi

install_module
exit 0
